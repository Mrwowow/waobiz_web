APP_NAME="WaoBiz"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

MAIL_MAILER=array

# Disable external services for CI
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# Payment gateways disabled for CI
STRIPE_PUB_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_APP_SECRET=
PAYPAL_MODE=sandbox

# Other services disabled
OPENAI_API_KEY=
GOOGLE_MAP_API_KEY=
ENABLE_RECAPTCHA=false
